# Supabase bağlantı bilgileri
# Supabase Dashboard > Project Settings > API bölümünden alınır.
# Bu iki değer public'tir (anon key RLS ile korunur), service_role anahtarını ASLA buraya koymayın.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Yönetim paneli. Panelde yalnızca "admin" yazılır; burada verilen adrese
# eşlenir. Bu adres Supabase Auth'un iç kimliğidir — gerçek bir posta kutusu
# olmak zorunda değildir, oraya hiçbir şey gönderilmez.
# Şifre kodda TUTULMAZ; Supabase kullanıcısını oluştururken siz belirlersiniz.
VITE_ADMIN_EMAIL=admin@decha.local

# Site bilgileri (opsiyonel)
VITE_SITE_URL=https://decha-agency.netlify.app
